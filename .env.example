OPS_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6
QIANWEN_API_KEY=
QIANWEN_MODEL=
OPS_SSH_TARGET=root@your-server
OPS_SSH_PORT=22
OPS_SSH_AUTH=password
OPS_SSH_PASSWORD=
# Only used when OPS_SSH_AUTH=key.
OPS_SSH_IDENTITY=C:/Users/yourname/.ssh/ops_agent
# 0 disables the corresponding limit; output limit is characters per stream.
OPS_COMMAND_TIMEOUT=600
OPS_COMMAND_OUTPUT_LIMIT=48000
OPS_MAX_STEPS=128
# Optional: defaults to audit.sqlite3 in the project directory.
# OPS_AGENT_DB=
